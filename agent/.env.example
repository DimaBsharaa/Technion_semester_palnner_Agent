# Copy this file to  agent/.env  and paste the course API key below.
# agent/.env is gitignored - your real key never gets committed.

# --- Course LLMod proxy settings (shared team setup) ---
OPENAI_API_KEY=PASTE_THE_SHARED_LLMOD_KEY_HERE
OPENAI_BASE_URL=https://api.llmod.ai/v1
OPENAI_MODEL=MB5R2CF-azure/gpt-5.4-mini

# Safety guardrail: the max estimated $ a single planning turn may spend.
SESSION_BUDGET_USD_CAP=0.15

# --- Alternative: personal OpenAI account instead of LLMod ---
# OPENAI_API_KEY=sk-...your own key...
# OPENAI_BASE_URL=            <- leave EMPTY to use real OpenAI
# OPENAI_MODEL=gpt-5.4-mini
