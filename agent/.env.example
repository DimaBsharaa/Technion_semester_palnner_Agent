# Copy this file to  agent/.env  and paste the course API key below.
# agent/.env is gitignored - your real key never gets committed.

# --- Course LLMod proxy settings (shared team setup) ---
OPENAI_API_KEY=PASTE_THE_SHARED_LLMOD_KEY_HERE
OPENAI_BASE_URL=https://api.llmod.ai/v1
OPENAI_MODEL=MB5R2CF-azure/gpt-5.4-mini

# Configured and available for a future semantic-search feature - not
# called by anything yet. Optional; leave as-is or omit entirely.
EMBEDDING_MODEL=MB5R2CF-azure/text-embedding-3-small

# Safety guardrail: the max estimated $ a single planning turn may spend.
SESSION_BUDGET_USD_CAP=0.15

# --- Alternative: personal OpenAI account instead of LLMod ---
# OPENAI_API_KEY=sk-...your own key...
# OPENAI_BASE_URL=            <- leave EMPTY to use real OpenAI
# OPENAI_MODEL=gpt-5.4-mini

# --- Supabase (optional: student session persistence) ---
# Leave both empty to run with no persistence (local dev works exactly the
# same either way - see agent/student_store.py). Service role key only -
# never the anon/public key, and never expose it to the browser; the
# frontend always goes through this backend, never Supabase directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
